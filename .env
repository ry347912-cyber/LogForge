# LogForge Environment Configuration
# IMPORTANT: Change SECRET_KEY in production!
SECRET_KEY=logforge-super-secret-key-change-in-production-2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite for dev, switch to PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./logforge.db
# For PostgreSQL: DATABASE_URL=postgresql+asyncpg://logforge:password@localhost/logforge

# CORS - add your frontend URL
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:80","http://127.0.0.1:3000"]

# Alert Thresholds
FAILED_LOGIN_THRESHOLD=5
BRUTE_FORCE_WINDOW_SECONDS=300
ANOMALY_SCORE_THRESHOLD=0.7
CPU_ALERT_THRESHOLD=90.0

# Log Retention
MAX_LOG_RETENTION_DAYS=30
MAX_LOGS_PER_PAGE=100

# ML
ANOMALY_DETECTION_ENABLED=true
MIN_LOGS_FOR_TRAINING=100

# Debug mode (set false in production)
DEBUG=false
